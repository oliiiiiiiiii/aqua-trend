# Copy to the repository root as .env for docker compose. Never commit keys.
PORT=8080
SELECTOR_BACKEND=keyword
SELECTOR_URL=http://host.docker.internal:8770
SELECTOR_OPENAI_BASE_URL=https://api.openai.com/v1
SELECTOR_OPENAI_MODEL=
SELECTOR_SYSTEMONE_URL=
SELECTOR_SYSTEMONE_MODEL=
SELECTOR_ONLINE_TIMEOUT_MS=5000
SELECTOR_API_KEY=
# bearer (default: send SELECTOR_API_KEY) or google-adc (Google Application Default Credentials).
SELECTOR_AUTH=

# Gemini on Vertex AI with ADC: use deploy/compose.gemini.yaml and set
# SELECTOR_OPENAI_BASE_URL=https://aiplatform.googleapis.com/v1/projects/<PROJECT_ID>/locations/global/endpoints/openapi
# SELECTOR_OPENAI_MODEL=google/gemini-2.5-flash
# GOOGLE_ADC_HOST_FILE=./gcp-adc.json

# Optional daily data. Prefer the read-only secret mount in compose.earthdata.yaml.
EDL_TOKEN_HOST_FILE=./.edl.token
# Alternatively inject EDL_TOKEN through the deployment platform's runtime secrets.
# EDL_TOKEN=
