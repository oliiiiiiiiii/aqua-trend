# 選變數後端（工作線 D）。複製成 .env.local 再改；.env.local 不會被 commit。
# local（預設，本機 OneJev）| openai | systemone | keyword
SELECTOR_BACKEND=local
SELECTOR_URL=http://127.0.0.1:8770

# openai：任何 OpenAI 相容 API（OpenAI、OpenRouter、Groq、vLLM、Ollama…）
# SELECTOR_OPENAI_BASE_URL=https://api.openai.com/v1
# SELECTOR_OPENAI_MODEL=
# systemone：遠端 Jev 風格 /v1/systemone 端點（完整網址）
# SELECTOR_SYSTEMONE_URL=
# SELECTOR_SYSTEMONE_MODEL=
# 兩種線上後端共用的金鑰（Bearer）與逾時
# SELECTOR_API_KEY=
# SELECTOR_ONLINE_TIMEOUT_MS=10000
