# Base URL of the analysis backend (FastAPI, backend/aqua_trend/api.py) used by the /research page.
# It is baked into the static export at build time. Default when unset: http://localhost:8000
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Optional: path prefix when the static site is served from a sub-directory (leave unset for the root).
# NEXT_PUBLIC_BASE_PATH=
