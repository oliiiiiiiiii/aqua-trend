# Only website build inputs and container configuration enter the build context.
**
!Dockerfile
!.dockerignore
!deploy/
!deploy/nginx.conf
!deploy/check-data.mjs
!web/
!web/package.json
!web/package-lock.json
!web/next.config.ts
!web/tsconfig.json
!web/postcss.config.mjs
!web/data.lock.json
!web/app/
!web/app/**
!web/components/
!web/components/**
!web/lib/
!web/lib/**
!web/scripts/
!web/scripts/setup-data.mjs
!web/scripts/prep-data.mjs
!web/public/
!web/public/**
!web/data/
!web/data/meta.json
!web/data/series/
!web/data/series/*.i16
!web/data/trends/
!web/data/trends/*.json

# Regenerate derived data inside the image from the pinned bundle's inputs.
web/public/data/gen/

**/.git
**/.aqua-trend
**/.env
**/.env.*
**/.envrc
**/.npmrc
**/.netrc
**/secrets
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.token
**/node_modules
**/.next
**/out
**/*.tsbuildinfo
**/.DS_Store
**/._*
**/* [0-9]*
